<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Definición del informe -->
    <record id="rother_product_label_dymo" model="ir.actions.report">
        <field name="name">Etiqueta Dymo Rother</field>
        <field name="model">product.template</field>
        <field name="report-type">qweb-pdf</field>
        <field name="report_name">rother.report_label_dymo_rother</field>
        <field name="report_file">rother.report_label_dymo_rother</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="rother_paperformat_dymo" />
    </record>

    <!-- Formato del papel -->
    <record id="rother_paperformat_dymo" model="report.paperformat">
        <field name="name">Dymo 30x62</field>
        <field name="default_paper_format">custom</field>
        <field name="format">custom</field>
        <field name="page_height">30</field>
        <field name="page_width">62</field>
        <field name="orientation">Vertical</field>
        <field name="margin-top">1</field>
        <field name="margin-bottom">1</field>
        <field name="margin-left">1</field>
        <field name="margin-right">1</field>
        <field name="header_line">False</field>
        <field name="header_spacing">3</field>
        <field name="dpi">96</field>
    </record>

    <!-- Template de la etiqueta -->
    <template id="report_label_dymo_rother">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div style="width: 62mm; height: 30mm; padding: 1mm; display:flex; flex-direction: column; justify-content: space-between; overflow: hidden; page-break-after: always;">
                    <!-- Código de barras -->
                    <div style ="text-align: center;">
                        <t t-if:"o.barcode">
                            <img t-att-src="'/report/barcode/Code128/' + o.barcode" style="height: 12mm; width: 100%" />
                            <div style="font-size: 7pt; margin-top: 0.5mm;">
                                <span t-out="o.barcode" />
                            </div>
                        </t>
                    </div>

                    <!-- Nombre del producto -->
                    <div style="font-size: 7pt; font-weight: bold; line-height: 1.1; overflow: hidden;">
                        <span t-field="o.name"/>
                    </div>

                    <!-- Referencia y Referencia Fabricante -->
                    <div style="font-size: 6pt; display:flex; justify-content: space-between;">
                        <span t-field="o.default_code" />
                        <span t-field="o.x_Ref_fab" />
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>